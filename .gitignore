# ============================================================
# RepoSketch - The Astral Cartographer
# .gitignore
# ============================================================

# ---- Dependencies ----
node_modules/
**/node_modules/

# ---- Environment Variables ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep the example file
!.env.example

# ---- Build Outputs ----
dist/
build/
out/
.output/

# ---- Cache ----
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# ---- OS Files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Test Coverage ----
coverage/
*.lcov
.nyc_output/

# ---- Temporary Repositories (cloned for analysis) ----
temp_repos/
**/temp_repos/

# ---- IDE & Editor ----
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ---- Vite ----
.vite/

# ---- Runtime ----
pids/
*.pid
*.seed
*.pid.lock

# ---- Optional npm cache ----
.npm

# ---- Optional Yarn ----
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ---- Misc ----
*.tgz
*.zip
.node_repl_history
